{
  "name": "wallet-tracker-bot",
  "version": "1.0.0",
  "description": "Multi-chain (EVM + Solana) wallet tracking Discord bot for memecoin/token apes. Tracks buys/sells, flags new-token launches, and computes per-wallet PnL.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --dns-result-order=ipv4first src/index.js",
    "dev": "node --watch --dns-result-order=ipv4first src/index.js",
    "test": "node --test",
    "setup": "node scripts/setup-env.js",
    "demo": "node scripts/demo.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy-commands": "node --dns-result-order=ipv4first src/deployCommands.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "~12.9.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
