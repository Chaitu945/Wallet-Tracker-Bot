# Discord bot
# Run `npm run setup` to fill these in interactively — it validates each value.
DISCORD_TOKEN=your_discord_bot_token_here

# Optional. The bot derives the application id from the token, which is
# authoritative; set this only if you need to override it. A channel or guild id
# looks identical (both are 17-20 digits) and produces "Unknown Application".
# DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Moralis (get a free key at https://moralis.com — one key covers EVM + Solana)
MORALIS_API_KEY=your_moralis_api_key_here

# How often (in minutes) to poll each tracked wallet for new activity.
# 1-59 = minutes, 60/120/180 = whole hours.
POLL_INTERVAL_MINUTES=2

# A token is flagged as a "fresh ape" if its liquidity pool is younger than this (minutes)
NEW_TOKEN_AGE_THRESHOLD_MINUTES=1440

# Robinhood Chain — uses Alchemy (same key works across all chains, including any you may
# already use for other projects). Get one free at https://dashboard.alchemy.com if needed.
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Optional: where to store the SQLite file. Defaults to ./tracker.sqlite
# TRACKER_DB_PATH=./tracker.sqlite
